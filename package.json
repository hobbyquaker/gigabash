{
  "name": "oganesson",
  "private": true,
  "version": "1.3.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/oganesson.html')\" && vite build --config vite.replay.config.ts",
    "build:server": "tsc -p server && node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/server.mjs",
    "preview": "vite preview",
    "test:sim": "esbuild tests/determinism.test.ts --bundle --platform=node --format=esm --outfile=build/determinism.test.mjs --log-level=warning && node build/determinism.test.mjs",
    "test:replay": "esbuild tests/replay.test.ts --bundle --platform=node --format=esm --define:__APP_VERSION__='\"0.0.0\"' --define:__APP_COMMIT__='\"test\"' --define:__APP_BUILD_DATE__='\"\"' --outfile=build/replay.test.mjs --log-level=warning && node build/replay.test.mjs",
    "test:server": "npm run build:server && node server/test/api.test.mjs",
    "balance": "esbuild tests/balance.ts --bundle --platform=node --format=esm --outfile=build/balance.mjs --log-level=warning && node build/balance.mjs",
    "audio": "node scripts/audio-levels.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "artwork": "node scripts/render-artwork.mjs",
    "freeze-core": "node scripts/freeze-core.mjs"
  },
  "dependencies": {
    "@fontsource/exo-2": "5.2.8",
    "@fontsource/russo-one": "5.3.0",
    "phaser": "3.90.0",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
